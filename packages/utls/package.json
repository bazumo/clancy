{
  "name": "@clancyapp/utls",
  "version": "0.0.5-beta.0",
  "description": "uTLS provider for Clancy proxy - TLS fingerprint spoofing",
  "type": "module",
  "author": "bazumo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazumo/clancy.git",
    "directory": "packages/utls"
  },
  "homepage": "https://github.com/bazumo/clancy#readme",
  "bugs": {
    "url": "https://github.com/bazumo/clancy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && bash tls-go/build.sh",
    "build:binaries": "bash tls-go/build.sh",
    "prepublishOnly": "tsc",
    "clean": "rm -rf dist platforms/*/bin"
  },
  "keywords": [
    "tls",
    "utls",
    "fingerprint",
    "chrome",
    "firefox",
    "safari"
  ],
  "optionalDependencies": {
    "@clancyapp/utls-linux-x64": "0.0.5-beta.0",
    "@clancyapp/utls-linux-arm64": "0.0.5-beta.0",
    "@clancyapp/utls-darwin-x64": "0.0.5-beta.0",
    "@clancyapp/utls-darwin-arm64": "0.0.5-beta.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.8",
    "typescript": "~5.9.3"
  }
}
