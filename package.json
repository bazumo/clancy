{
  "name": "clancy-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/shared",
    "packages/utls",
    "packages/utls/platforms/linux-x64",
    "packages/utls/platforms/linux-arm64",
    "packages/utls/platforms/darwin-x64",
    "packages/utls/platforms/darwin-arm64",
    "packages/frontend",
    "packages/backend",
    "packages/app"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "turbo run dev:server --filter=clancy-proxy",
    "build": "turbo run build",
    "build:binaries": "turbo run build:binaries --filter=@clancyapp/utls",
    "build:all": "turbo run build build:server build:binaries",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:unit": "turbo run test:unit",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-platform-versions.js",
    "release": "turbo run build && node scripts/publish.js",
    "pre:beta": "changeset pre enter beta",
    "pre:exit": "changeset pre exit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.8",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.17"
  }
}
