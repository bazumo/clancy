{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "platforms/**/bin/**"]
    },
    "build:server": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:binaries": {
      "outputs": ["bin/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
